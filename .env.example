# Lunar — copy to `.env` at the repository root (never commit real secrets).
# Backend loads `../.env` then `Backend/.env` when started from Backend/.
# Frontend (Vite) loads from the repo root via `envDir`.

# --- Backend (Go / Gin) ---
PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Firebase Admin credentials (pick one):
# 1) File path (cwd is usually Backend/ when running `go run`)
# FIREBASE_SERVICE_ACCOUNT=../Database/firebase-config/service-account.json
# 2) Inline JSON string (good for hosting; keep on one line or use env-specific UI)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# 3) Same as (2): FIREBASE_SERVICE_ACCOUNT may be inline JSON if the value starts with "{"
FIREBASE_SERVICE_ACCOUNT=../Database/firebase-config/service-account.json

# --- Frontend (Vite) — only VITE_* vars are exposed to the browser ---
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: client-side Firebase (FCM / messaging in src/lib/firebase.ts)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
