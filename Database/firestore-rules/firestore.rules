rules_version = '2';

// Lunar: all catalog, orders, and auth tokens are accessed via the Go backend
// (Firebase Admin SDK), which bypasses these rules. This keeps client-side
// direct Firestore access closed unless you explicitly open paths later.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
